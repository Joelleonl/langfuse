.github/workflows/*.lock.yml linguist-generated=true
# Loader and typings written by `napi build` from the Rust exports.
packages/native/index.js linguist-generated=true
packages/native/index.d.ts linguist-generated=true
# ClickHouse migrations are validated byte-for-byte (LF only); keep LF on Windows checkouts.
packages/shared/clickhouse/migrations/**/*.sql text eol=lf
# Shell scripts run inside Linux containers (e.g. web/entrypoint.sh); CRLF breaks them.
*.sh text eol=lf
